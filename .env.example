# Supabase PostgreSQL Connection Strings
# Transaction connection pooler URL (for Next.js serverless route handlers)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Direct connection URL (for Prisma CLI migrations and prisma db push)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Weather API Configuration (Open-Meteo API is 100% free and requires NO key!)
OPENWEATHER_API_KEY="your_openweather_api_key_here"
WEATHER_API_PROVIDER="open-meteo" # "open-meteo" | "openweather"

# YouTube Data API v3 Key (Generous Free Quota of 10,000 requests/day)
# Optional: App gracefully falls back to Unsplash photo galleries if empty
YOUTUBE_API_KEY="your_youtube_api_key_here"

# Unsplash Access Key (100% Free API for destination images)
UNSPLASH_ACCESS_KEY="your_unsplash_access_key_here"

# Public Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_UNITS="metric" # "metric" | "imperial"
